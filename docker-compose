version: "3.9"

services:
  predictive-maintenance:
    build: .
    container_name: ai-predictive-maintenance
    ports:
      - "8501:8501"
    volumes:
      # Mount model folder so you can update models without rebuilding the image
      - ./model:/app/model:ro
      # Mount dataset folder (read-only)
      - ./dataset:/app/dataset:ro
    restart: unless-stopped
    environment:
      - STREAMLIT_SERVER_HEADLESS=true
      - STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
